{
	"name": "@hypn4/chappie",
	"version": "0.6.0-rc.3",
	"description": "Maintained Chappie fork connecting ChatGPT to Pi and Oh My Pi",
	"devDependencies": {
		"@earendil-works/pi-ai": "^0.85.1",
		"@earendil-works/pi-coding-agent": "^0.85.1",
		"@earendil-works/pi-tui": "^0.85.1",
		"@oh-my-pi/pi-ai": "^18.4.4",
		"@oh-my-pi/pi-coding-agent": "^18.4.4",
		"@oh-my-pi/pi-utils": "^18.4.4",
		"@types/node": "^26.5.1",
		"typebox": "^1.3.30",
		"typescript": "^7.0.2"
	},
	"scripts": {
		"format": "biome check --write .",
		"check": "biome check . && tsc && node --test",
		"test": "node --test",
		"build": "node scripts/build.mjs",
		"prepack": "node scripts/build.mjs",
		"test:omp": "node scripts/verify-omp.mjs",
		"test:otunnel": "node scripts/verify-otunnel.mjs",
		"verify:package": "node scripts/verify-package.mjs"
	},
	"keywords": [
		"pi-package",
		"omp",
		"chatgpt",
		"mcp"
	],
	"author": "zetaloop",
	"license": "MIT",
	"packageManager": "pnpm@12.4.1",
	"type": "module",
	"engines": {
		"node": ">=26",
		"pnpm": ">=12"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": ">=0.85.1 <0.88.0",
		"@earendil-works/pi-coding-agent": ">=0.85.1 <0.88.0",
		"@earendil-works/pi-tui": ">=0.85.1 <0.88.0",
		"@oh-my-pi/pi-ai": ">=18.3.0 <19.0.0",
		"@oh-my-pi/pi-coding-agent": ">=18.3.0 <19.0.0",
		"@oh-my-pi/pi-utils": ">=18.3.0 <19.0.0",
		"typebox": "^1.3.30"
	},
	"peerDependenciesMeta": {
		"@oh-my-pi/pi-ai": {
			"optional": true
		},
		"@oh-my-pi/pi-coding-agent": {
			"optional": true
		},
		"@oh-my-pi/pi-utils": {
			"optional": true
		}
	},
	"dependencies": {
		"@modelcontextprotocol/server": "^2.0.0",
		"mime": "^4.1.0",
		"zod": "^4.6.4"
	},
	"files": [
		"src",
		"docs",
		"dist"
	],
	"publishConfig": {
		"tag": "latest",
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hypn4/chappie.git"
	},
	"omp": {
		"extensions": [
			"./src/index.omp.ts"
		]
	},
	"bin": {
		"chappie-omp": "./dist/src/cli.omp.js"
	},
	"homepage": "https://github.com/hypn4/chappie#readme",
	"bugs": {
		"url": "https://github.com/hypn4/chappie/issues"
	},
	"contributors": [
		{
			"name": "hypn4",
			"url": "https://github.com/hypn4"
		}
	]
}
